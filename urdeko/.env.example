# =====================================================================
# UrdeKo — variables d'environnement (TOUTES REQUISES)
# =====================================================================
# Pour le dev local, copie .env.local.example → .env.local (stack Docker).
# Pour la prod, configure chaque service puis remplis ces vars sur Vercel.
# =====================================================================

# ----- Core -----
DATABASE_URL="postgresql://urdeko:urdeko@localhost:5432/urdeko"
AUTH_SECRET=""                               # openssl rand -base64 48
AUTH_URL="http://localhost:3000"

# ----- Resend (emails + magic link Auth.js) -----
RESEND_API_KEY="re_ZBWnRHe4_47T6qD2ZsDaEqsSwkfrTjXod"
AUTH_EMAIL_FROM="UrdeKo <hello@urdeko.app>"

# ----- Google Gemini -----
GEMINI_API_KEY="AIzaSyBHjcYS4OmflgFv4S5kLPvSge2TTTuRB6g"
GEMINI_TEXT_MODEL="gemini-2.5-pro"
GEMINI_IMAGE_MODEL="gemini-3.1-flash-image-preview"
AI_IMAGE_MAX_EDGE=1536
# Vide-pièce : température basse = moins d’hallucination (autre angle / autre pièce). Plage 0.01–2.
AI_EMPTY_ROOM_TEMPERATURE=0.35
# Optionnel : graine entière pour des re-générations plus stables (tests).
# AI_EMPTY_ROOM_SEED=42

# ----- Storage S3-compatible (Cloudflare R2 prod / MinIO local) -----
S3_ENDPOINT="http://localhost:9000"
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET="urdeko"
S3_PUBLIC_URL="http://localhost:9000/urdeko"
S3_FORCE_PATH_STYLE="true"                   # true pour MinIO, false pour R2

# ----- Sanity (catalogue produits) -----
NEXT_PUBLIC_SANITY_PROJECT_ID=""
NEXT_PUBLIC_SANITY_DATASET="production"
SANITY_API_TOKEN=""                          # token avec droits Editor
SANITY_REVALIDATE_SECRET=""                  # min 16 chars, aléatoire

# ----- Inngest (jobs asynchrones) -----
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""
INNGEST_BASE_URL="http://localhost:8288"     # laisse vide en prod

# ----- Redis (rate limiting, cache) -----
REDIS_URL="redis://localhost:6379"

# ----- Observabilité -----
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""                         # optionnel, pour upload source maps
SENTRY_ORG=""                                # slug de l'org Sentry (ex: urdeko)
SENTRY_PROJECT=""                            # slug du projet (ex: urdeko-web)

# ----- Mentions légales (affichées dans /cgu, /mentions-legales, etc.) -----
LEGAL_COMPANY_NAME="UrdeKo"
LEGAL_COMPANY_ADDRESS="Casablanca, Maroc"
LEGAL_CONTACT_EMAIL="hello@urdeko.app"
