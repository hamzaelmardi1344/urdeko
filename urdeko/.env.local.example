# =====================================================================
# UrdeKo — variables d'environnement pour le dev local (stack Docker).
# Copie ce fichier en .env.local puis complète :
#   - GEMINI_API_KEY
#   - RESEND_API_KEY
#   - NEXT_PUBLIC_SANITY_PROJECT_ID + SANITY_API_TOKEN
#     (crée un projet free sur https://sanity.io, voir docs/DEPLOYMENT.md §1.3)
#   - SANITY_REVALIDATE_SECRET (openssl rand -hex 24)
#   - AUTH_SECRET (openssl rand -base64 48)
# Les autres valeurs ci-dessous pointent sur les services Docker locaux,
# avec des ports décalés (+50000) pour éviter les conflits.
# =====================================================================

NODE_ENV="development"

# ----- Ports Docker (surchargent docker-compose si modifiés) -----
POSTGRES_HOST_PORT="55432"
MINIO_HOST_PORT="59000"
MINIO_CONSOLE_PORT="59001"
INNGEST_HOST_PORT="58288"
REDIS_HOST_PORT="56379"
WEB_HOST_PORT="3300"
SCRAPER_HOST_PORT="3330"

# ----- Core -----
DATABASE_URL="postgresql://urdeko:urdeko@localhost:55432/urdeko"
AUTH_SECRET="change-me-openssl-rand-base64-48-please"
AUTH_URL="http://localhost:3300"

# ----- Resend (à renseigner) -----
RESEND_API_KEY=""
AUTH_EMAIL_FROM="UrdeKo dev <onboarding@resend.dev>"

# ----- Gemini (à renseigner) -----
GEMINI_API_KEY=""
GEMINI_TEXT_MODEL="gemini-2.5-pro"
GEMINI_IMAGE_MODEL="gemini-3.1-flash-image-preview"
AI_IMAGE_MAX_EDGE=1536
AI_EMPTY_ROOM_TEMPERATURE=0.35
# AI_EMPTY_ROOM_SEED=42

# ----- MinIO (stack Docker, ports décalés) -----
S3_ENDPOINT="http://localhost:59000"
S3_REGION="auto"
S3_ACCESS_KEY_ID="urdeko"
S3_SECRET_ACCESS_KEY="urdeko-dev-secret"
S3_BUCKET="urdeko"
S3_PUBLIC_URL="http://localhost:59000/urdeko"
S3_FORCE_PATH_STYLE="true"

# ----- Sanity (à renseigner, voir docs/DEPLOYMENT.md §1.3) -----
NEXT_PUBLIC_SANITY_PROJECT_ID=""
NEXT_PUBLIC_SANITY_DATASET="production"
SANITY_API_TOKEN=""
SANITY_REVALIDATE_SECRET="change-me-openssl-rand-hex-24"

# ----- Inngest (dev server Docker) -----
INNGEST_EVENT_KEY="dev"
INNGEST_SIGNING_KEY="dev"
INNGEST_BASE_URL="http://localhost:58288"

# ----- Redis (stack Docker) -----
REDIS_URL="redis://localhost:56379"

# ----- Sentry (optionnel en dev, mais une valeur non vide est requise) -----
NEXT_PUBLIC_SENTRY_DSN="https://dev@sentry.local/0"
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# ----- Infos légales dev -----
LEGAL_COMPANY_NAME="UrdeKo"
LEGAL_COMPANY_ADDRESS="Casablanca, Maroc"
LEGAL_CONTACT_EMAIL="hello@urdeko.app"
