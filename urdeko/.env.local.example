# =====================================================================
# UrdeKo — variables d'environnement pour le dev local (stack Docker).
# Copie ce fichier en .env.local puis complète :
#   - GEMINI_API_KEY
#   - SMTP_USER / SMTP_PASSWORD (Gmail = mot de passe d’application)
#   - AUTH_SECRET (openssl rand -base64 48)
#   - INTERNAL_JOB_SECRET (openssl rand -hex 32)
#   - CRON_SECRET (openssl rand -hex 16)
# Les autres valeurs ci-dessous pointent sur les services Docker locaux,
# avec des ports décalés (+50000) pour éviter les conflits.
# =====================================================================

NODE_ENV="development"

# ----- Ports Docker (surchargent docker-compose si modifiés) -----
POSTGRES_HOST_PORT="55432"
MINIO_HOST_PORT="59000"
MINIO_CONSOLE_PORT="59001"
REDIS_HOST_PORT="56379"
WEB_HOST_PORT="3300"

# ----- Core -----
DATABASE_URL="postgresql://urdeko:urdeko@localhost:55432/urdeko"
AUTH_SECRET="change-me-openssl-rand-base64-48-please"
AUTH_URL="http://localhost:3300"

# ----- SMTP Gmail (à renseigner) -----
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
AUTH_EMAIL_FROM="UrdeKo dev <ton.email@gmail.com>"

# ----- Gemini (à renseigner) -----
GEMINI_API_KEY=""
GEMINI_TEXT_MODEL="gemini-2.5-pro"
GEMINI_IMAGE_MODEL="gemini-3.1-flash-image-preview"
AI_IMAGE_MAX_EDGE=1536
AI_EMPTY_ROOM_TEMPERATURE=0.35
# AI_EMPTY_ROOM_SEED=42

# ----- MinIO (stack Docker, ports décalés) -----
S3_ENDPOINT="http://localhost:59000"
S3_REGION="auto"
S3_ACCESS_KEY_ID="urdeko"
S3_SECRET_ACCESS_KEY="urdeko-dev-secret"
S3_BUCKET="urdeko"
S3_PUBLIC_URL="http://localhost:59000/urdeko"
S3_FORCE_PATH_STYLE="true"

# ----- Jobs internes (file fire-and-forget vers /api/jobs/run) -----
INTERNAL_JOB_SECRET="dev_internal_job_secret_change_me_min_32_chars_long"

# ----- Vercel Cron (scrape hebdo, inutile en dev) -----
CRON_SECRET="dev_cron_secret_change_me"

# ----- Redis (stack Docker) -----
REDIS_URL="redis://localhost:56379"

# ----- Infos légales dev -----
LEGAL_COMPANY_NAME="UrdeKo"
LEGAL_COMPANY_ADDRESS="Casablanca, Maroc"
LEGAL_CONTACT_EMAIL="hello@urdeko.app"
