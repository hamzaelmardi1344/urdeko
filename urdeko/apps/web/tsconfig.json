{
  "extends": "@urdeko/tsconfig/nextjs.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts",
    "drizzle.config.ts",
    "next.config.mjs"
  ],
  "exclude": ["node_modules", ".next", "dist"]
}
