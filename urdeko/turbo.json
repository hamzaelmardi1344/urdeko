{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalPassThroughEnv": [
    "POSTGRES_HOST_PORT",
    "MINIO_HOST_PORT",
    "MINIO_CONSOLE_PORT",
    "REDIS_HOST_PORT",
    "WEB_HOST_PORT",
    "SCRAPER_HOST_PORT",
    "SKIP_ENV_VALIDATION",
    "VERCEL",
    "VERCEL_ENV",
    "VERCEL_URL",
    "CI"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": [
        "NODE_ENV",
        "NEXT_PUBLIC_*",
        "DATABASE_URL",
        "AUTH_SECRET",
        "AUTH_URL",
        "AUTH_EMAIL_FROM",
        "RESEND_API_KEY",
        "GEMINI_API_KEY",
        "GEMINI_TEXT_MODEL",
        "GEMINI_IMAGE_MODEL",
        "S3_*",
        "SANITY_*",
        "INNGEST_*",
        "REDIS_URL",
        "SENTRY_*",
        "LEGAL_*",
        "ADMIN_EMAILS",
        "AI_IMAGE_MAX_EDGE",
        "AI_EMPTY_ROOM_TEMPERATURE",
        "AI_EMPTY_ROOM_SEED"
      ]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "db:push": {
      "cache": false
    },
    "db:studio": {
      "cache": false,
      "persistent": true
    },
    "scrape": {
      "cache": false
    },
    "seed": {
      "cache": false
    }
  }
}
