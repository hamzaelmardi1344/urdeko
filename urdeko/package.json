{
  "name": "urdeko",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:push": "turbo run db:push",
    "db:studio": "turbo run db:studio",
    "scrape": "turbo run scrape --filter=@urdeko/scraper",
    "northflank:sync-env": "node scripts/sync-northflank-env.mjs",
    "northflank:sync-env:dry": "node scripts/sync-northflank-env.mjs --dry-run"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "typescript": "^5.6.3",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.8"
  },
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=9"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.14",
      "@types/react-dom": "19.2.3",
      "@esbuild-kit/core-utils>esbuild": "0.25.12",
      "fast-xml-parser": "5.7.2",
      "postcss": "8.5.13"
    }
  }
}
